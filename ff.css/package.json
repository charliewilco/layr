{
  "name": "ff.css",
  "private": true,
  "version": "0.2.0",
  "description": "Font-family utility classes and variables",
  "main": "index.css",
  "browser": "dist/ff.css",
  "files": [
    "families.json",
    "index.css",
    "dist/*"
  ],
  "scripts": {
    "clean": "del ./dist",
    "dev": "postcss index.css -o dist/ff.css --watch",
    "build": "postcss index.css -o dist/ff.css && node scripts/export-css-vars.mjs index.css families.json",
    "check": "npm run lint",
    "lint": "stylelint index.css"
  },
  "keywords": [
    "css",
    "typography",
    "font-families",
    "system",
    "fonts"
  ],
  "author": "charles peters <charlespeters42@gmail.com>",
  "license": "MIT",
  "repository": "charliewilco/layr",
  "bugs": {
    "url": "https://github.com/charliewilco/layr/issues"
  },
  "homepage": "https://github.com/charliewilco/layr/tree/main/ff.css",
  "devDependencies": {
    "del-cli": "^7.0.0",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "postcss-custom-properties": "^15.0.1",
    "stylelint": "^17.14.1"
  },
  "stylelint": {
    "rules": {
      "block-no-empty": true,
      "color-no-invalid-hex": true,
      "no-invalid-double-slash-comments": true
    }
  }
}
