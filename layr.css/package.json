{
  "name": "layr.css",
  "private": true,
  "version": "3.1.0",
  "description": "A live ITCSS reference implementation for teams",
  "keywords": [
    "css",
    "modular css",
    "postcss"
  ],
  "main": "src/index.css",
  "browser": "dist/layr.min.css",
  "files": [
    "css.json",
    "parker.json",
    "dist/*",
    "src/**/*.css"
  ],
  "scripts": {
    "lint": "stylelint './src/**/*.css'",
    "clean": "del ./dist",
    "dev": "npm run build:dev -- --watch",
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "postcss src/index.css -o dist/layr.css && node scripts/export-css-vars.mjs dist/layr.css css.json",
    "build:prod": "postcss dist/layr.css --env production -o dist/layr.min.css --no-map"
  },
  "author": "charles peters <charlespeters42@gmail.com>",
  "license": "MIT",
  "repository": "charliewilco/layr",
  "bugs": {
    "url": "https://github.com/charliewilco/layr/issues"
  },
  "homepage": "https://charliewilco.github.io/layr",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "del-cli": "^7.0.0",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-parker": "^0.1.0",
    "postcss-reporter": "^7.1.0",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "last 1 versions"
  ],
  "stylelint": {
    "rules": {
      "block-no-empty": true,
      "color-no-invalid-hex": true,
      "declaration-block-no-duplicate-properties": true,
      "no-invalid-double-slash-comments": true
    }
  },
  "cssnano": {
    "preset": [
      "default",
      {
        "discardComments": {
          "removeAllButFirst": true
        }
      }
    ]
  }
}
