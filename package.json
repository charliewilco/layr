{
  "name": "layr",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "modern-parker",
    "postcss-parker",
    "layr.css",
    "pluton.css",
    "documentation",
    "sass-port"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "precommit": "lint-staged",
    "clean": "bash scripts/clean.sh",
    "build": "turbo run build --filter=!layr.scss",
    "build:sass": "npm run build --workspace layr.scss",
    "check": "turbo run check --filter=!layr.scss",
    "lint": "turbo run lint",
    "test": "npm run test --workspace modern-parker && npm run test --workspace postcss-parker"
  },
  "prettier": {
    "printWidth": 85,
    "singleQuote": false,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "bracketSameLine": true
  },
  "lint-staged": {
    "*.{astro,js,jsx,json,md,mdx,ts,tsx,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --parser postcss --write"
    ]
  }
}
