{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "types": [
      "astro/client"
    ]
  },
  "include": [
    "src/**/*",
    "components/**/*",
    "markdown/**/*",
    "astro.config.mjs"
  ]
}
